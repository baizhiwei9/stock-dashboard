{
  "key": "ot_unified",
  "title": "最优传输OT统一日报（靠岸+多空+资金）",
  "desc": "",
  "section": "stock",
  "metrics": [],
  "sched": {
    "mode": "daily",
    "at": "18:30",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "cmd": "PYTHONPATH=\"${PYLIBS_DIR:?请先设置 PYLIBS_DIR 指向 pylibs 目录}:.\" python3 -u ot_unified_daily.py",
  "cwd": ".",
  "timeout": 1800,
  "enabled": true,
  "deliver": {
    "report": true,
    "email": false
  },
  "code_files": 8,
  "requires": [
    "pylibs"
  ],
  "root": "{WS}/skills/user/optimal-transport-ot",
  "entry": "ot_unified_daily.py",
  "needs_llm": false,
  "imported_from": "case/_seed/tasks.json + _tools/collect_code.py",
  "import_note": "含动态 import，按入口目录模块集兜底；外部依赖：pylibs",
  "pipeline": {
    "on_fail": "continue",
    "freshness_days": 5,
    "min_ok_ratio": 0.3,
    "require_data": false,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "report": [
        "out/*.html",
        "out/*.md",
        "out/*.png",
        "out/*.json"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "hook": true,
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      },
      {
        "name": "dispatch",
        "hook": true,
        "timeout": 1800,
        "optional": true
      }
    ]
  },
  "legacy_cmd": "PYTHONPATH=\"${PYLIBS_DIR:?请先设置 PYLIBS_DIR 指向 pylibs 目录}:.\" python3 -u ot_unified_daily.py"
}
