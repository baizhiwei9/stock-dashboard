{
  "key": "options_midday",
  "title": "期权午盘",
  "desc": "期权午盘监控；算法在 options_utility 仓，本任务只做薄包装",
  "section": "option",
  "visibility": "public",
  "metrics": [
    {
      "key": "opt.mid.iv.300ETF",
      "sec": "OPT.IV",
      "name": "300ETF ATM IV",
      "unit": "%",
      "dec": 2
    },
    {
      "key": "opt.mid.iv.500ETF",
      "sec": "OPT.IV",
      "name": "500ETF ATM IV",
      "unit": "%",
      "dec": 2
    },
    {
      "key": "opt.mid.iv.创业板ETF",
      "sec": "OPT.IV",
      "name": "创业板ETF ATM IV",
      "unit": "%",
      "dec": 2
    },
    {
      "key": "opt.mid.iv.科创50ETF",
      "sec": "OPT.IV",
      "name": "科创50ETF ATM IV",
      "unit": "%",
      "dec": 2
    },
    {
      "key": "opt.mid.iv.中证1000",
      "sec": "OPT.IV",
      "name": "中证1000 ATM IV",
      "unit": "%",
      "dec": 2
    },
    {
      "key": "opt.mid.ivskew.300ETF",
      "sec": "OPT.IV",
      "name": "300ETF IV偏度",
      "unit": "pp",
      "dec": 2
    },
    {
      "key": "opt.mid.ivskew.500ETF",
      "sec": "OPT.IV",
      "name": "500ETF IV偏度",
      "unit": "pp",
      "dec": 2
    },
    {
      "key": "opt.mid.ivskew.创业板ETF",
      "sec": "OPT.IV",
      "name": "创业板ETF IV偏度",
      "unit": "pp",
      "dec": 2
    },
    {
      "key": "opt.mid.ivskew.科创50ETF",
      "sec": "OPT.IV",
      "name": "科创50ETF IV偏度",
      "unit": "pp",
      "dec": 2
    },
    {
      "key": "opt.mid.ivskew.中证1000",
      "sec": "OPT.IV",
      "name": "中证1000 IV偏度",
      "unit": "pp",
      "dec": 2
    }
  ],
  "sched": {
    "mode": "daily",
    "at": "12:30",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "cmd": "python3 -u run.py",
  "cwd": ".",
  "timeout": 900,
  "enabled": true,
  "deliver": {
    "report": false,
    "email": false
  },
  "source_repo": "baizhiwei9/options_utility",
  "source_entry": "alert/reports/midday.py",
  "original_cron_name": "期权午盘",
  "pipeline": {
    "on_fail": "continue",
    "freshness_days": 5,
    "min_ok_ratio": 0.3,
    "require_data": false,
    "require_report": false,
    "require_metrics": true,
    "artifacts": {
      "report": [
        "out/latest.json"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "cmd": "python3 -u run.py",
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      }
    ]
  }
}
