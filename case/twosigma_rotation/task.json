      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      },
      {
        "name": "dispatch",
        "hook": true,
        "timeout": 1800,
        "optional": true
      }
    ]
  },
  "legacy_cmd": "PYTHONPATH=\"${PYLIBS_DIR:?请先设置 PYLIBS_DIR 指向 pylibs 目录}:.\" python3 -u run_weekly.py",
