{
  "key": "cftc_cot_weekly",
  "title": "CFTC COT 极值持仓周报",
  "desc": "四个境外商品的管理基金净持仓 104 周分位，判断极值方向、已持续周数与剩余持有窗口",
  "section": "futures",
  "section_domain": "",
  "visibility": "public",
  "metrics": [
    {
      "key": "cot.index",
      "sec": "CU.SHF",
      "name": "COMEX铜 COT104 分位",
      "dec": 3
    },
    {
      "key": "cot.weeks_left",
      "sec": "CU.SHF",
      "name": "COMEX铜 剩余持有周数",
      "dec": 0
    },
    {
      "key": "cot.direction",
      "sec": "CU.SHF",
      "name": "COMEX铜 COT 方向",
      "dec": 0,
      "text": true
    },
    {
      "key": "cot.index",
      "sec": "AU.SHF",
      "name": "COMEX黄金 COT104 分位",
      "dec": 3
    },
    {
      "key": "cot.weeks_left",
      "sec": "AU.SHF",
      "name": "COMEX黄金 剩余持有周数",
      "dec": 0
    },
    {
      "key": "cot.direction",
      "sec": "AU.SHF",
      "name": "COMEX黄金 COT 方向",
      "dec": 0,
      "text": true
    },
    {
      "key": "cot.index",
      "sec": "AG.SHF",
      "name": "COMEX白银 COT104 分位",
      "dec": 3
    },
    {
      "key": "cot.weeks_left",
      "sec": "AG.SHF",
      "name": "COMEX白银 剩余持有周数",
      "dec": 0
    },
    {
      "key": "cot.direction",
      "sec": "AG.SHF",
      "name": "COMEX白银 COT 方向",
      "dec": 0,
      "text": true
    }
  ],
  "sched": {
    "mode": "weekly",
    "at": "09:00",
    "weekdays": [
      6
    ]
  },
  "cmd": "python3 -u pipeline.py",
  "cwd": ".",
  "timeout": 3600,
  "enabled": true,
  "needs_llm": false,
  "deliver": {
    "report": true,
    "email": false
  },
  "pipeline": {
    "on_fail": "stop",
    "freshness_days": 10,
    "min_ok_ratio": 0.5,
    "require_data": true,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "data": [
        "data/cot_panel.csv",
        "data/stage_*.json"
      ],
      "report": [
        "out/report.md"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "hook": true,
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "render",
        "hook": true,
        "timeout": 1800
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      },
      {
        "name": "dispatch",
        "hook": true,
        "timeout": 600,
        "optional": true
      }
    ]
  }
}