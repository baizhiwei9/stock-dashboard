{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "case task metadata",
  "description": "dumate 分支 case/<key>/task.json 的字段契约，调度器与看板共用",
  "type": "object",
  "required": [
    "key",
    "title",
    "section",
    "metrics",
    "sched",
    "cmd"
  ],
  "additionalProperties": true,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,40}$",
      "description": "唯一任务键，必须与目录名一致"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "面板显示标题"
    },
    "desc": {
      "type": "string",
      "description": "一句话说明"
    },
    "section": {
      "type": "string",
      "enum": [
        "stock",
        "futures",
        "realestate",
        "macro",
        "liquidity",
        "bond",
        "modules",
        "option",
        "risk"
      ],
      "description": "面板标签，对应 sections.json 的 key"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "description": "要在面板展示的指标",
      "items": {
        "type": "object",
        "required": [
          "key",
          "sec"
        ],
        "additionalProperties": true,
        "properties": {
          "key": {
            "type": "string",
            "description": "指标键，如 chanlun.bull_score"
          },
          "sec": {
            "type": "string",
            "description": "证券/对象 id，如 000300.SH / AU.SHF / CN.MACRO"
          },
          "name": {
            "type": "string",
            "description": "展示名"
          },
          "unit": {
            "type": "string"
          },
          "dec": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "sched": {
      "type": "object",
      "required": [
        "mode",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "ISO 星期：1=周一 … 7=周日；daily/weekly 使用"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "description": "每月第几天；monthly 使用"
        }
      }
    },
    "cmd": {
      "type": "string",
      "minLength": 1,
      "description": "执行命令，相对 cwd"
    },
    "cwd": {
      "type": "string",
      "description": "运行目录，默认 case/<key>"
    },
    "timeout": {
      "type": "integer",
      "minimum": 60,
      "default": 1800
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "deliver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report": {
          "type": "boolean",
          "description": "任务自身是否会发报告"
        },
        "email": {
          "type": "boolean",
          "description": "任务自身是否会发邮件"
        }
      }
    },
    "original_cwd": {
      "type": "string",
      "description": "迁移前源目录，仅溯源"
    }
  }
}
