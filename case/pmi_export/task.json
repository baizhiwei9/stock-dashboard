{
  "key": "pmi_export",
  "title": "pmi 出口 月度展望报告推送",
  "desc": "PMI 出口展望",
  "section": "macro",
  "metrics": [],
  "sched": {
    "mode": "monthly",
    "at": "21:00",
    "days": [
      28
    ]
  },
  "cmd": "python3 -u run_monthly.py",
  "cwd": ".",
  "timeout": 1800,
  "enabled": true,
  "deliver": {
    "report": true,
    "email": false
  },
  "code_files": 17,
  "requires": [],
  "root": "{WS}/macro_monthly_report",
  "entry": "run_monthly.py",
  "needs_llm": false,
  "imported_from": "case/_seed/tasks.json + _tools/collect_code.py",
  "pipeline": {
    "on_fail": "continue",
    "freshness_days": 40,
    "min_ok_ratio": 0.3,
    "require_data": false,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "report": [
        "out/*.html",
        "out/*.md",
        "out/*.png",
        "out/*.json"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "hook": true,
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      },
      {
        "name": "dispatch",
        "hook": true,
        "timeout": 1800,
        "optional": true
      }
    ]
  },
  "legacy_cmd": "python3 -u run_monthly.py",
  "visibility": "public"
}
