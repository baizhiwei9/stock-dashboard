  "sched": {
    "mode": "weekly",
    "at": "15:30",
    "weekdays": [
      7
    ]
  },
  "cmd": "python3 -u pipeline.py",
  "cwd": ".",
  "timeout": 10800,
  "enabled": false,
  "needs_llm": false,
  "deliver": {
    "report": true,
    "email": false
  },
  "pipeline": {
    "on_fail": "stop",
    "freshness_days": 9,
    "min_ok_ratio": 0.5,
    "require_data": true,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "data": [
        "data/stage_*.json"
      ],
      "report": [
        "out/report.md"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "hook": true,
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "render",
        "hook": true,
        "timeout": 9000
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      },
      {
        "name": "dispatch",
        "hook": true,
        "timeout": 600,
        "optional": true
      }
    ]
  }
}
