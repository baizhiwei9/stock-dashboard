{
  "key": "clearance_cycle",
  "title": "A股出清周期监控",
  "desc": "沪深300 MA40/MA80 定义出清周期边界；被动化率与年化基差衡量出清进度；情绪温度独立成表；QVIX 与基差 250 日分位双高/双低切换发邮件",
  "section": "risk",
  "visibility": "public",
  "sched": {
    "mode": "daily",
    "at": "14:50",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "metrics": [],
  "depends_on": [],
  "enabled": true,
  "timeout": 1800,
  "deliver": {
    "report": true,
    "email": true
  },
  "pipeline": {
    "on_fail": "stop",
    "freshness_days": 5,
    "min_ok_ratio": 0.5,
    "require_data": true,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "data": [
        "data/*.json",
        "data/*.csv"
      ],
      "report": [
        "out/report.md",
        "out/*.html"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "cmd": "python3 -u fetch.py",
        "timeout": 1500
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "render",
        "cmd": "python3 -u render.py",
        "timeout": 600
      },
      {
        "name": "emit",
        "hook": true
      },
      {
        "name": "dispatch",
        "cmd": "python3 -u dispatch.py",
        "optional": true
      }
    ]
  },
  "note": "两条推送规则独立：均线口径 MA40 上穿 MA80 后 dispatch 静默；双分位口径 QVIX 与基差分位同时 ≥70% 发风险邮件、同时 <70% 发出清邮件，只在状态切换时发信，首跑只建基线。被动化率 7% 提醒线已并入双分位邮件正文，不再单独发信。14:50 为盘中口径（日线未收），报告与邮件正文均自动标注"盘中数据，非收盘价"。fetch 阶段回看 15 个月合约以支撑 250 日基差分位"
}
