  "desc": "CME FedWatch 加息/降息概率 + 中国降准降息预期利差 + 土狗框架",
  "section": "liquidity",
  "metrics": [
    {
      "key": "rate.us.fedwatch.hike_next",
      "sec": "RATE.BOARD",
      "name": "FedWatch下次会议加息概率"
    },
    {
      "key": "rate.us.fedwatch.hold_next",
      "sec": "RATE.BOARD",
      "name": "FedWatch下次会议维持不变概率"
    },
    {
      "key": "rate.us.fedwatch.ease_next",
      "sec": "RATE.BOARD",
      "name": "FedWatch下次会议降息概率"
    },
    {
      "key": "rate.us.fedwatch.target_mid",
      "sec": "RATE.BOARD",
      "name": "FedWatch隐含目标利率中值"
    },
    {
      "key": "rate.us.fedwatch.days",
      "sec": "RATE.BOARD",
      "name": "距下次FOMC会议天数"
    },
    {
      "key": "rate.us.fedwatch.meeting",
      "sec": "RATE.BOARD",
      "name": "下次FOMC会议日"
    },
    {
      "key": "rate.us.fedwatch.hike_prev_1d",
      "sec": "RATE.BOARD",
      "name": "加息概率·1天前"
    },
    {
      "key": "rate.us.fedwatch.hike_prev_1w",
      "sec": "RATE.BOARD",
      "name": "加息概率·1周前"
    },
    {
      "key": "rate.us.fedwatch.hike_prev_1m",
      "sec": "RATE.BOARD",
