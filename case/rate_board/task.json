  "sched": {
    "mode": "daily",
    "at": "21:10",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "cmd": "python3 -u run.py",
  "cwd": ".",
  "timeout": 900,
  "enabled": true,
  "deliver": {
    "report": false,
    "email": false
  },
  "requires": [
    "pylibs"
  ],
  "visibility": "public",
  "pipeline": {
    "on_fail": "continue",
    "freshness_days": 3,
    "min_ok_ratio": 0.3,
    "require_data": false,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "report": [
        "out/report.md",
        "out/fedwatch.json"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "hook": true,
        "timeout": 900
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      }
    ]
  },
  "build_workers": false
}
