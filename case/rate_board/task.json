    {
      "key": "rate.cn.cdb_1y3m",
      "sec": "RATE.BOARD",
      "name": "国开债1Y-3M利差（降准降息预期核心）"
    },
    {
      "key": "rate.cn.ncd_1y3m",
      "sec": "RATE.BOARD",
      "name": "同业存单1Y-3M利差（同上印证）"
