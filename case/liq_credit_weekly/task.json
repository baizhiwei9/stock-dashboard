{
  "key": "liq_credit_weekly",
  "title": "流动性 · 信用风险周报（中国 / 美国）",
  "desc": "分层传导链：资金面 → 传导 → 定价极端度，中国侧与美国侧分别出报告并给压力分",
  "section": "liquidity",
  "section_domain": "",
  "visibility": "public",
  "metrics": [
    {"key": "liq.credit.cn_score", "sec": "CN.LIQ", "name": "中国流动性信用压力分", "dec": 0},
    {"key": "liq.credit.us_score", "sec": "GLOBAL.MACRO", "name": "美国流动性信用压力分", "dec": 0},
    {"key": "liq.stress_level", "sec": "CN.LIQ", "name": "流动性·信用压力档", "dec": 0}
  ],
  "sched": {
    "mode": "weekly",
    "at": ["08:30", "11:00"],
    "weekdays": [7]
  },
  "cmd": "python3 -u pipeline.py",
  "cwd": ".",
  "timeout": 5400,
  "enabled": false,
  "needs_llm": false,
  "deliver": {"report": true, "email": false},
  "pipeline": {
    "on_fail": "stop",
    "freshness_days": 9,
    "min_ok_ratio": 0.5,
    "require_data": true,
    "require_report": true,
    "require_metrics": true,
    "artifacts": {
      "data": ["data/stage_*.json"],
      "report": ["out/report_cn.md", "out/report_us.md"]
    },
    "stages": [
      {"name": "fetch", "hook": true, "timeout": 3000},
      {"name": "check", "builtin": "artifacts"},
      {"name": "render", "hook": true, "timeout": 2400},
      {"name": "emit", "hook": true, "builtin": "emit"},
      {"name": "dispatch", "hook": true, "timeout": 600, "optional": true}
    ]
  }
}
