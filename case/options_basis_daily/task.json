{
  "key": "options_basis_daily",
  "title": "期货基差日报",
  "desc": "期货基差日频计算 + MA20 报告；算法在 options_utility 仓，本任务只做薄包装",
  "section": "futures",
  "visibility": "public",
  "metrics": [
    {
      "key": "opt.basis.pct.IF",
      "sec": "OPT.BASIS",
      "name": "沪深300基差率",
      "unit": "%",
      "dec": 3
    },
    {
      "key": "opt.basis.pct.IC",
      "sec": "OPT.BASIS",
      "name": "中证500基差率",
      "unit": "%",
      "dec": 3
    },
    {
      "key": "opt.basis.pct.IM",
      "sec": "OPT.BASIS",
      "name": "中证1000基差率",
      "unit": "%",
      "dec": 3
    }
  ],
  "sched": {
    "mode": "daily",
    "at": "16:30",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "cmd": "python3 -u run.py",
  "cwd": ".",
  "timeout": 900,
  "enabled": true,
  "deliver": {
    "report": false,
    "email": false
  },
  "source_repo": "baizhiwei9/options_utility",
  "source_entry": "calc/basis_daily.py + alert/tasks/basis_ma20.py",
  "original_cron_name": "期货基差日报",
  "pipeline": {
    "on_fail": "continue",
    "freshness_days": 5,
    "min_ok_ratio": 0.3,
    "require_data": false,
    "require_report": false,
    "require_metrics": true,
    "artifacts": {
      "report": [
        "out/latest.json"
      ]
    },
    "stages": [
      {
        "name": "fetch",
        "cmd": "python3 -u run.py",
        "timeout": 1800
      },
      {
        "name": "check",
        "builtin": "artifacts"
      },
      {
        "name": "emit",
        "hook": true,
        "builtin": "emit"
      }
    ]
  }
}
