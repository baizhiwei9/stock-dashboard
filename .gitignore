# 运行时产物
index.html
private.html
# 私有页把任务产出的图拷到这里（数据，不是代码）
assets/private/
pub/
logs/
__pycache__/
*.pyc
scheduler.pid
daily.log

# 运行状态（每次跑都在变，不入库）
state.json
registry.json

# case 任务的抓数缓存与产出：每天新增几十个按日期命名的文件，
# 属于本机数据，不是代码。仓库里一个都不放（git ls-files 应查不到 /data/ /out/）。
case/*/data/
case/*/out/
# case 跨任务共用目录里的运行产物（_shared 下只有代码入库）
case/_shared/reports/*
!case/_shared/reports/.gitkeep
case/_shared/limit_up_predictor/output/*
!case/_shared/limit_up_predictor/output/.gitkeep
# 模型与行业映射是任务运行必需的数据（不是每日产出），必须入库
!case/_shared/limit_up_predictor/output/stacking_model_latest.pkl
!case/_shared/limit_up_predictor/output/sw_l3_industry_map_v2.json
case/_shared/limit_up_predictor/catboost_info/
# 任务自己的历史报告与运行日志（每日新增，属本机数据）；
# 只忽略目录内容 —— 任务目录里的 daily_reports 符号链接要入库
case/*/daily_reports/*
case/*/logs/
# 运行期缓存 / 内存态（2026-11-27 补）：wide_ens_lib、liq_lib、market_momentum 等
# 会把模型/抓数缓存写进任务目录、甚至 case/_shared/<pkg>/cache，跑一轮就在 git status
# 冒一批未跟踪文件。此前 case/foo/cache、case/_shared/wide_ens_lib/cache 都未被忽略。
# 注意：这里只忽略“以后新产生”的缓存，已入库的历史文件不受影响（tracked 文件不被 .gitignore 影响）。
case/*/.cache/
case/*/memory/
case/*/cache/
case/_shared/*/.cache/
case/_shared/*/cache/

# ===== 安装配置 =====
# modules.json 已入库（2026-11-26 起）：cwd/cmd 全部改成
# {{DATAHUB_ROOT}} / {{REPO_ROOT}} / {{FEISHU_CLI_DIR}} 占位符，由
# datahub_path.expand_module() 在拉起任务时展开，文件内不再有本机绝对路径，
# 新机器 clone 下来直接能用（见 DEPLOY_PORTABLE.md §3）。
# modules.example.json 仅作字段参考保留。
modules.json.bak_*

# 云平台部署元数据
.coze

# ===== 敏感配置（绝不入库）=====
# 飞书 APP ID / APP Secret / Webhook、调度器管理密码与注册密钥、Tushare token、
# SMTP 授权码、FRED key、TreasuryDirect 凭据，一律走
# ~/.config/stock-dashboard/secrets.json 或环境变量。
# 仓库里只保留 case/_lib/secrets.example.json 占位模板。
# 详见 docs/SECRETS.md / DEPLOY.md「敏感配置」一节。
secrets.json
feishu_secret.json
*.secret.json
.env
.env.*
!.env.example


# 运行时状态
case/_lib/.alert_quota.json
.switches.local.json
case/manning_flow/weekly_report_*.json

# 模拟盘账户状态与产出（每次跑都在变，属本机运行数据）
case/*/sim_trade/state/
case/*/sim_trade/output/

# 运行期临时目录（.tmp/trunc 里会残留脚本快照，含调试输出，可能带凭据）
**/.tmp/
**/trunc/
